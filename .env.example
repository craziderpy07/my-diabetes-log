# Copy to .env, replace with your Neon connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
FLASK_DEBUG=1
# Set to 1 behind HTTPS in production
COOKIE_SECURE=0
# On Vercel, set these as Environment Variables in the project settings instead of using a .env file.
